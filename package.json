{
  "name": "ai-ark",
  "version": "0.0.0",
  "private": true,
  "description": "Governed GitHub-to-Skill Technical Alpha",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "22.23.1",
    "pnpm": "11.7.0"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "db:migrate": "node scripts/scoped-command.mjs db:migrate",
    "db:validate": "node scripts/scoped-command.mjs db:validate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && pnpm lint:boundaries && pnpm lint:source-safety",
    "lint:boundaries": "node scripts/check-dependency-boundaries.mjs",
    "lint:source-safety": "node scripts/check-source-safety.mjs",
    "test": "vitest run",
    "test:adversarial": "vitest run --config vitest.adversarial.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:fixtures": "vitest run --config vitest.fixture.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "typecheck": "turbo run typecheck",
    "validation:report": "node scripts/scoped-command.mjs validation:report",
    "validation:technical": "node scripts/scoped-command.mjs validation:technical",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:unit && pnpm test:contract && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "turbo": "2.10.8",
    "tsx": "4.23.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
